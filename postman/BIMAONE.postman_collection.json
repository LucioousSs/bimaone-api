{
  "info": {
    "_postman_id": "bimaone-api-local",
    "name": "BIMAONE API",
    "description": "Koleksi endpoint BE BIMAONE: brands, warehouses, health, beserta contoh error. Import bersama environment `BIMAONE Local`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Cek Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Memastikan server API hidup."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Brands",
      "item": [
        {
          "name": "List Brand",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/brands?status=all&page=1&per_page=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "brands"],
              "query": [
                { "key": "status", "value": "all" },
                { "key": "page", "value": "1" },
                { "key": "per_page", "value": "10" }
              ]
            },
            "description": "Daftar brand. status: active (default) | archived | all. search opsional."
          },
          "response": []
        },
        {
          "name": "Tambah Brand",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Grundfos\",\n  \"description\": \"Pompa sentrifugal dan booster\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/brands",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "brands"]
            },
            "description": "Tambah brand. Sukses 201."
          },
          "response": []
        },
        {
          "name": "Detail Brand",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/brands/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "brands", "1"]
            },
            "description": "Detail satu brand berdasarkan id."
          },
          "response": []
        },
        {
          "name": "Ubah Brand",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Grundfos\",\n  \"description\": \"Pompa booster\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/brands/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "brands", "1"]
            },
            "description": "Ubah brand. Sukses 200."
          },
          "response": []
        },
        {
          "name": "Arsip Brand",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/brands/1/archive",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "brands", "1", "archive"]
            },
            "description": "Arsipkan brand (isi archived_at). Sukses 200."
          },
          "response": []
        },
        {
          "name": "Pulihkan Brand",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/brands/1/restore",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "brands", "1", "restore"]
            },
            "description": "Pulihkan brand dari arsip (archived_at = NULL). Sukses 200."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Warehouses",
      "item": [
        {
          "name": "List Gudang",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/warehouses?status=all&page=1&per_page=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "warehouses"],
              "query": [
                { "key": "status", "value": "all" },
                { "key": "page", "value": "1" },
                { "key": "per_page", "value": "10" }
              ]
            },
            "description": "Daftar gudang. search mencari di code dan name."
          },
          "response": []
        },
        {
          "name": "Tambah Gudang",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"GDG-DPS-01\",\n  \"name\": \"Gudang Denpasar\",\n  \"address\": \"Jl. Contoh No. 1\",\n  \"pic_name\": \"Budi\",\n  \"phone\": \"08123456789\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/warehouses",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "warehouses"]
            },
            "description": "Tambah gudang. code wajib huruf besar, unik, maks 20. Sukses 201."
          },
          "response": []
        },
        {
          "name": "Detail Gudang",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/warehouses/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "warehouses", "1"]
            },
            "description": "Detail satu gudang berdasarkan id."
          },
          "response": []
        },
        {
          "name": "Ubah Gudang",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"GDG-DPS-01\",\n  \"name\": \"Gudang Denpasar Utama\",\n  \"address\": \"Jl. Contoh No. 2\",\n  \"pic_name\": \"Budi\",\n  \"phone\": \"08123456789\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/warehouses/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "warehouses", "1"]
            },
            "description": "Ubah gudang (termasuk code). Sukses 200."
          },
          "response": []
        },
        {
          "name": "Arsip Gudang",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/warehouses/1/archive",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "warehouses", "1", "archive"]
            },
            "description": "Arsipkan gudang. Sukses 200."
          },
          "response": []
        },
        {
          "name": "Pulihkan Gudang",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/warehouses/1/restore",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "warehouses", "1", "restore"]
            },
            "description": "Pulihkan gudang dari arsip. Sukses 200."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Contoh Error",
      "item": [
        {
          "name": "400 - ID bukan angka",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/warehouses/abc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "warehouses", "abc"]
            },
            "description": "Menghasilkan 400 BAD_REQUEST."
          },
          "response": [
            {
              "name": "400 BAD_REQUEST",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/v1/warehouses/abc",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "warehouses", "abc"]
                }
              },
              "status": "Bad Request",
              "code": 400,
              "_postman_previewlanguage": "json",
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "cookie": [],
              "body": "{\n  \"error\": {\n    \"code\": \"BAD_REQUEST\",\n    \"message\": \"ID gudang tidak valid\",\n    \"fields\": {}\n  }\n}"
            }
          ]
        },
        {
          "name": "404 - Tidak ditemukan",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/warehouses/999999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "warehouses", "999999"]
            },
            "description": "Menghasilkan 404 NOT_FOUND."
          },
          "response": [
            {
              "name": "404 NOT_FOUND",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/v1/warehouses/999999",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "warehouses", "999999"]
                }
              },
              "status": "Not Found",
              "code": 404,
              "_postman_previewlanguage": "json",
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "cookie": [],
              "body": "{\n  \"error\": {\n    \"code\": \"NOT_FOUND\",\n    \"message\": \"Data dengan id itu tidak ada\",\n    \"fields\": {}\n  }\n}"
            }
          ]
        },
        {
          "name": "409 - Kode duplikat",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"GDG-DPS-01\",\n  \"name\": \"Gudang Duplikat\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/warehouses",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "warehouses"]
            },
            "description": "Jalankan setelah kode GDG-DPS-01 ada. Menghasilkan 409 DUPLICATE."
          },
          "response": [
            {
              "name": "409 DUPLICATE",
              "originalRequest": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"code\": \"GDG-DPS-01\",\n  \"name\": \"Gudang Duplikat\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/warehouses",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "warehouses"]
                }
              },
              "status": "Conflict",
              "code": 409,
              "_postman_previewlanguage": "json",
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "cookie": [],
              "body": "{\n  \"error\": {\n    \"code\": \"DUPLICATE\",\n    \"message\": \"Kode gudang sudah digunakan\",\n    \"fields\": { \"code\": \"Kode gudang sudah digunakan\" }\n  }\n}"
            }
          ]
        },
        {
          "name": "422 - Validasi gagal",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/warehouses",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "warehouses"]
            },
            "description": "Body kosong. Menghasilkan 422 VALIDATION_ERROR."
          },
          "response": [
            {
              "name": "422 VALIDATION_ERROR",
              "originalRequest": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": { "mode": "raw", "raw": "{}" },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/warehouses",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "warehouses"]
                }
              },
              "status": "Unprocessable Entity",
              "code": 422,
              "_postman_previewlanguage": "json",
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "cookie": [],
              "body": "{\n  \"error\": {\n    \"code\": \"VALIDATION_ERROR\",\n    \"message\": \"Data tidak valid\",\n    \"fields\": {\n      \"code\": \"Kode gudang wajib diisi\",\n      \"name\": \"Nama gudang wajib diisi\"\n    }\n  }\n}"
            }
          ]
        },
        {
          "name": "400 - Status tidak valid",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/warehouses?status=xxx",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "warehouses"],
              "query": [{ "key": "status", "value": "xxx" }]
            },
            "description": "Menghasilkan 400 BAD_REQUEST."
          },
          "response": [
            {
              "name": "400 BAD_REQUEST",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/v1/warehouses?status=xxx",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "warehouses"],
                  "query": [{ "key": "status", "value": "xxx" }]
                }
              },
              "status": "Bad Request",
              "code": 400,
              "_postman_previewlanguage": "json",
              "header": [
